# Codyssey gateway (OpenAI-compatible base URL)
OPENAI_API_BASE=https://copa.codyssey.kr/v1
# Codyssey API key (sk-cody-live-...)
OPENAI_API_KEY=
# Models on the gateway used for Claude Code's big/small requests
BIG_MODEL=claude-sonnet-4
SMALL_MODEL=claude-haiku-4
# Proxy listen settings
PROXY_HOST=127.0.0.1
PROXY_PORT=8082