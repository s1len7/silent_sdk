# Codyssey gateway base URL (with or without /v1)
CODYSSEY_BASE_URL=https://copa.codyssey.kr

# Codyssey OpenAI-compatible API key
CODYSSEY_OPENAI_API_KEY=

# Note: CODYSSEY_ANTHROPIC_API_KEY is intentionally not used by codyssey-proxy.
# It may return HTTP 200 from /v1/models, but OpenAI-compatible chat requests fail with 403:
# "This API key is not allowed for the OpenAI-compatible API. Use an OpenAI-compatible key."
# Therefore, use CODYSSEY_OPENAI_API_KEY only.
# CODYSSEY_ANTHROPIC_API_KEY=

# Models on the gateway used for Claude Code's big/small requests
BIG_MODEL=claude-sonnet-4
SMALL_MODEL=claude-haiku-4

# Proxy listen settings
PROXY_HOST=127.0.0.1
PROXY_PORT=8082
