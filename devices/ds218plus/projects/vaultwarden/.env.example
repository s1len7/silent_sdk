# NAS의 /volume1/docker/vaultwarden/.env 에 두는 값 (git에 올리지 않음)
# vaultwarden 외부 주소 (예: https://vaultwarden.example.com)
VW_DOMAIN=
# authentik 애플리케이션 vaultwarden 주소, 끝에 / 필수 (예: http://<NAS IP>:39000/application/o/vaultwarden/)
VW_SSO_AUTHORITY=
# authentik 애플리케이션 vaultwarden의 클라이언트 ID·비밀값
VW_SSO_CLIENT_ID=
VW_SSO_CLIENT_SECRET=
