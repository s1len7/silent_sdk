# NAS의 /volume1/docker/grafana/.env 에 두는 값 (git에 올리지 않음)
# 브라우저로 여는 Grafana 주소 (예: http://<NAS IP>:33000), authentik 로그인 뒤 돌아올 주소에 쓰임
GRAFANA_ROOT_URL=
# authentik 주소 (예: http://<NAS IP>:39000)
AUTHENTIK_URL=
# authentik 애플리케이션 grafana의 클라이언트 ID·비밀값
GRAFANA_OAUTH_CLIENT_ID=
GRAFANA_OAUTH_CLIENT_SECRET=
