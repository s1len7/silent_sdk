# cp .env.example .env 후 값을 채운다 (.env는 git에 올라가지 않음)
# 키 발급 방법은 README의 "ADS-B 피더" 참고

# 시간대
FEEDER_TZ=Asia/Seoul

# 안테나 위치: 위도, 경도, 해발 고도(m, 숫자만) - 필수
FEEDER_LAT=
FEEDER_LONG=
FEEDER_ALT_M=

# 서비스별 키 - 비어 있으면 그 서비스는 실행하지 않음
FR24KEY=
PIAWARE_FEEDER_ID=
AIRNAVRADAR_SHARING_KEY=
PLANEFINDER_SHARECODE=
