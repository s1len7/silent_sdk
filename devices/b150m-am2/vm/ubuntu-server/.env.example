# cp .env.example .env 후 필요한 값만 채운다 (.env는 git에 올라가지 않음)
# scripts/setup_openclaw_onboard.sh가 사용

# OpenRouter API 키 (https://openrouter.ai/keys 에서 무료 발급, 비우면 키 없이 온보딩만 진행)
OPENROUTER_API_KEY=

# Gemini API 키 (https://aistudio.google.com/apikey 에서 무료 발급, 비우면 Gemini 연결 안 함, 기본 모델은 그대로 OpenRouter)
GEMINI_API_KEY=

# 리버스 프록시(예: NAS의 Nginx Proxy Manager)를 거쳐 wss로 접속할 때만 채움 (비우면 랜 공개만 함)
# OPENCLAW_TRUSTED_PROXY: Gateway에서 보이는 프록시 IP (예: 192.168.0.2)
# OPENCLAW_PUBLIC_ORIGIN: 외부 https 주소, 경로 없이 (예: https://openclaw.example.com)
OPENCLAW_TRUSTED_PROXY=
OPENCLAW_PUBLIC_ORIGIN=

# 텔레그램 채널 (scripts/setup_openclaw_telegram.sh, 비우면 건너뜀)
# TELEGRAM_BOT_TOKEN: @BotFather에서 받은 봇 토큰
# TELEGRAM_ALLOW_FROM: 봇에게 말을 걸 수 있는 텔레그램 숫자 ID 하나 (@userinfobot에게 메시지를 보내면 알려 줌)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOW_FROM=
