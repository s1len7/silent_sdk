# cp .env.example .env 후 필요한 값만 채운다 (.env는 git에 올라가지 않음, 비워 두면 기본값 사용)
# scripts/host/setup_vm.sh가 OpenClaw용 Ubuntu Server 24.04 VM을 만들 때 사용

# VM 번호, 이름, 사양 (기본: 100, ubuntu-server, 2코어, 2048MB, 32GB)
VM_ID=
VM_NAME=
VM_CORES=
VM_MEMORY_MB=
VM_DISK_GB=

# VM 디스크 저장소, 네트워크 브리지 (기본: local-lvm, vmbr0)
VM_STORAGE=
VM_BRIDGE=

# VM 로그인 계정 (기본: silent, sudo 가능)
VM_USER=

# 콘솔 로그인용 비밀번호 (비우면 비밀번호 없음, SSH는 키로만 접속)
VM_PASSWORD=

# VM에 넣을 SSH 공개키 파일 (기본: Proxmox 호스트의 /root/.ssh/authorized_keys)
VM_SSH_KEYS_FILE=

# 고정 IP (CIDR, 예: 10.10.10.2/24) 와 게이트웨이, DNS - VM_IP를 비우면 DHCP
VM_IP=
VM_GATEWAY=
VM_DNS=

# 첫 부팅 때 OpenClaw 자동 설치 (yes / no, 기본: yes)
VM_AUTO_OPENCLAW=

# 호스트 Wi-Fi (scripts/host/setup_wifi.sh, WIFI_SSID를 비우면 Wi-Fi 설정을 건너뜀)
# WIFI_PASSWORD를 비우면 비밀번호 없는 네트워크, WIFI_COUNTRY는 국가 코드 (예: KR), WIFI_INTERFACE는 기본: 첫 번째 무선 인터페이스
WIFI_SSID=
WIFI_PASSWORD=
WIFI_COUNTRY=
WIFI_INTERFACE=

# Wi-Fi 고정 IP (CIDR, 예: 192.168.0.25/24) 와 게이트웨이 - 비우면 DHCP
# 넣으면 유선이 끊겨도 Wi-Fi IP로 호스트에 접속됨 (공유기 DHCP 범위 밖 주소나 DHCP 예약 주소를 쓸 것)
WIFI_IP=
WIFI_GATEWAY=

# VM 정기 백업 (scripts/host/setup_vm_backup.sh, 기본: 매주 일요일 03:00, 최근 3개 보관, local 저장소)
# 일정은 systemd 달력 형식 (예: daily 03:00, sun 03:00)
VM_BACKUP_SCHEDULE=
VM_BACKUP_KEEP=
