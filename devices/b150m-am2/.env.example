# cp .env.example .env 후 필요한 값만 채운다 (.env는 git에 올라가지 않음, 비워 두면 기본값 사용)
# scripts/host/setup_vm_ubuntu_server.sh(OpenClaw VM), setup_vm_ubuntu_docker.sh(Docker VM)가 VM을 만들 때 사용

# VM 번호, 이름, 사양 (기본: 100, ubuntu-server, 2코어, 2048MB, 32GB)
VM_ID=
VM_NAME=
VM_CORES=
VM_MEMORY_MB=
VM_DISK_GB=

# VM 디스크 저장소, 네트워크 브리지 (기본: local-lvm, vmbr0)
VM_STORAGE=
VM_BRIDGE=

# VM 로그인 계정 (기본: silent, sudo 가능)
VM_USER=

# 콘솔 로그인용 비밀번호 (비우면 비밀번호 없음, SSH는 키로만 접속)
VM_PASSWORD=

# VM에 넣을 SSH 공개키 파일 (기본: Proxmox 호스트의 /root/.ssh/authorized_keys)
VM_SSH_KEYS_FILE=

# 첫 부팅 때 OpenClaw 자동 설치 (yes / no, 기본: yes)
VM_AUTO_OPENCLAW=

# Docker VM 번호, 이름(호스트 이름 <이름>.local로도 쓰임), 사양 (기본: 101, ubuntu-docker, 2코어, 3072MB, 32GB)
# 저장소·브리지·계정·비밀번호·SSH 키는 위 VM_* 값을 함께 씀
DOCKER_VM_ID=
DOCKER_VM_NAME=
DOCKER_VM_CORES=
DOCKER_VM_MEMORY_MB=
DOCKER_VM_DISK_GB=

# 첫 부팅 때 Docker·서비스 자동 설치 (yes / no, 기본: yes)
DOCKER_VM_AUTO_SETUP=

# 호스트 Wi-Fi (scripts/host/setup_wifi.sh, WIFI_SSID를 비우면 Wi-Fi 설정을 건너뜀)
# WIFI_PASSWORD를 비우면 비밀번호 없는 네트워크, WIFI_COUNTRY는 국가 코드 (예: KR), WIFI_INTERFACE는 기본: 첫 번째 무선 인터페이스
WIFI_SSID=
WIFI_PASSWORD=
WIFI_COUNTRY=
WIFI_INTERFACE=
