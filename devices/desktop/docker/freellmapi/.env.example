# FreeLLM API Docker Compose environment
# Put this file next to docker-compose.yml.

# Required: 64-char hex key. Keep the same value across backups/moves.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Server port
PORT=3001

# Bind address. Use 127.0.0.1 for localhost only, 0.0.0.0 for LAN access.
HOST_BIND=127.0.0.1

# Optional unified key reference for local tooling. FreeLLM API does not read this.
# FREELLMAPI_API_KEY=freellmapi-...