# cp .env.example .env 후 값을 채운다 (.env는 git에 올라가지 않음)
# scripts/setup-openclaw-gateway.ps1, ../generic-windows/scripts/setup-opencode.ps1, scripts/setup-openclaw-remote.ps1, scripts/setup-bitwarden-cli.ps1이 사용

# OpenRouter API 키 (https://openrouter.ai/keys 에서 무료 발급, 비우면 키 없이 로컬 OpenClaw만 설치)
OPENROUTER_API_KEY=

# Gemini API 키 (https://aistudio.google.com/apikey 에서 무료 발급, 비우면 OpenCode·OpenClaw에 Gemini를 연결하지 않음)
GEMINI_API_KEY=

# 원격 OpenClaw Gateway 연결 (scripts/setup-openclaw-remote.ps1, 아래 셋 중 하나라도 비우면 건너뜀)
# Gateway 주소: 외부에서도 쓰면 리버스 프록시의 wss 주소 (예: wss://openclaw.example.com), 랜에서만 쓰면 ws://192.168.0.19:18789
OPENCLAW_GATEWAY_URL=

# Gateway token: Gateway 장비의 ~/.openclaw/openclaw.json의 gateway.auth.token
# (openclaw config get은 값을 가려서 보여 줌, b150m-am2 VM은 devices/b150m-am2/vm/ubuntu-server/README.md의 ssh 명령 참고)
OPENCLAW_GATEWAY_TOKEN=

# Gateway 장비의 ssh 접속 대상 (예: silent@b150m-am2-vm), 트레이 앱 페어링 승인에 Setup 중에만 사용
# 비밀번호 없이(ssh 키로) 접속돼야 함
OPENCLAW_GATEWAY_SSH=

# Codyssey Public API key (https://copa.codyssey.kr) - Claude Code proxy and OpenAI tools
# COPA_API_KEY: sk-cody-live-...
COPA_API_KEY=

# Vaultwarden 서버 주소 (scripts/setup-bitwarden-cli.ps1이 Bitwarden CLI에 설정)
# HTTPS만 허용, 예: https://vaultwarden.example.com
VAULTWARDEN_URL=https://<vaultwarden-example>.duckdns.org

# 텔레그램 알림 (scripts/notify-telegram.ps1, 비우면 알림 건너뜀)
# 알림 전용 봇 토큰: @BotFather에서 /newbot으로 만들고, 그 봇에게 /start를 한 번 해야 DM을 보낼 수 있음
# 이 토큰으로 getUpdates를 호출하지 말 것 (발신 전용, 폴러를 띄우면 409 충돌)
TELEGRAM_NOTIFY_BOT_TOKEN=

# 알림을 받을 텔레그램 숫자 ID (@userinfobot). 비우면 TELEGRAM_ALLOW_FROM을 씀
TELEGRAM_NOTIFY_CHAT_ID=
